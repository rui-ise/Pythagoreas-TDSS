# Copy this file to .env and fill in your OpenRouter key. Never commit .env.
OPENROUTER_API_KEY=your_key_here
# Optional: default is openrouter/free. Use any OpenRouter model slug you prefer.
AI_MODEL=openrouter/free
# Local safety limit, reset each day. This is not your OpenRouter account quota.
AI_DAILY_LIMIT=12
# Prediction outcomes are graded with the latest Binance price after this many hours.
PREDICTION_CHECK_HOURS=24
