<Window x:Class="BinanceScannerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pythagoreas TDSS - Binance Scanner" Height="760" Width="1120" MinHeight="620" MinWidth="900"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource Text}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="PYTHAGOREAS TDSS" FontWeight="Bold" FontSize="25"/><TextBlock Text="Binance market data + local indicators + AI review" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
            <Border Grid.Column="1" Background="#172A45" CornerRadius="14" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="AUTO-SCAN - 4 HOURS" FontSize="11" FontWeight="SemiBold" Foreground="#9BC5FF"/></Border>
        </Grid>
        <TabControl Grid.Row="1" Background="{StaticResource Surface}" BorderThickness="0" Padding="4">
            <TabItem Header="  Overview  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Market" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><TextBox x:Name="SymbolBox" Text="BTCUSDT" Width="135" Margin="10,0,14,0"/><Button x:Name="ScanButton" Content="Scan market" Padding="18,9" Click="ScanButton_Click"/><Border Background="#172A45" CornerRadius="14" Padding="11,6" Margin="14,0,0,0"><TextBlock x:Name="AiUsageText" Text="AI: loading..." FontSize="11" Foreground="#9BC5FF"/></Border></StackPanel>
                    <TextBlock Grid.Row="1" x:Name="StatusText" Margin="0,18,0,16" Foreground="{StaticResource Muted}" Text="Ready. Axiom scans every four hours while open."/>
                    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Grid.Column="0"><StackPanel><TextBlock Text="LIVE PRICE" Style="{StaticResource Label}"/><TextBlock x:Name="PriceText" Text="-" Style="{StaticResource Metric}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Grid.Column="1"><StackPanel><TextBlock Text="4H AMD BIAS" Style="{StaticResource Label}"/><TextBlock x:Name="BiasText" Text="-" Style="{StaticResource Metric}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Grid.Column="2"><StackPanel><TextBlock Text="SETUP STATUS" Style="{StaticResource Label}"/><TextBlock x:Name="SignalText" Text="-" TextWrapping="Wrap" Style="{StaticResource MetricSmall}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Grid.Row="1" Grid.ColumnSpan="2"><StackPanel><TextBlock Text="FVG - INVERSION - RETEST" Style="{StaticResource Label}"/><TextBlock x:Name="GapText" Text="Waiting for scan" FontSize="16" Margin="0,9,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Grid.Row="1" Grid.Column="2"><StackPanel><TextBlock Text="HYPOTHETICAL TRADE PLAN" Style="{StaticResource Label}"/><TextBlock x:Name="PlanText" Text="No trade plan" FontSize="15" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                    </Grid>
                    <Border Grid.Row="3" Background="#101A2D" BorderBrush="#293959" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,6,14,10"><StackPanel><TextBlock Text="AI MARKET NOTES" Style="{StaticResource Label}"/><TextBlock x:Name="AiAnalysisText" Text="AI analysis will appear after a scan when OPENROUTER_API_KEY is configured." TextWrapping="Wrap" FontSize="15" LineHeight="23" Margin="0,10,0,0"/></StackPanel></Border>
                    <Border Grid.Row="4" Background="#16243B" BorderBrush="#2C4771" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0"><TextBlock Text="Read-only public Binance data. AI commentary is informational only, not trading or financial advice. This app never accesses an account or sends orders." Foreground="#B9D6FF" TextWrapping="Wrap"/></Border>
                </Grid></ScrollViewer>
            </TabItem>
            <TabItem Header="  Binance Charts  ">
                <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel><StackPanel><TextBlock Text="15-minute price action" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Latest 200 Binance candles - close-price view" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="Refresh data" Padding="16,8" Click="RefreshChart_Click"/></DockPanel>
                    <Border Grid.Row="1" Background="#0E1628" BorderBrush="#293959" BorderThickness="1" CornerRadius="10" Margin="0,18,0,0"><Canvas x:Name="PriceChart" Background="Transparent" SizeChanged="PriceChart_SizeChanged"/></Border>
                </Grid>
            </TabItem>
            <TabItem Header="  Scan History  ">
                <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="AI prediction history" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Predictions and outcome checks are stored locally." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><DataGrid Grid.Row="1" x:Name="HistoryGrid" Margin="0,18,0,0" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/></Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
